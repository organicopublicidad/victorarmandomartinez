---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { portada, nav } from '../data/contenido';
import logoApilado from '../assets/logo/logo-apilado.png';
import logoHorizontal from '../assets/logo/logo-horizontal.png';
import { foto } from '../lib/medios';
import Icono from './Icono.astro';
import Redes from './Redes.astro';

// Dirección de arte: foto horizontal en escritorio y vertical en celular (si existe)
const h = foto('portada');
const v = foto('portada-vertical');
const srcset = async (img: ImageMetadata | undefined, anchos: number[]) => {
  if (!img) return undefined;
  const out = await Promise.all(anchos.filter((w) => w <= img.width).map((w) => getImage({ src: img, width: w, format: 'webp', quality: 68 })));
  return out.map((o, i) => `${o.src} ${anchos[i]}w`).join(', ');
};
const srcH = await srcset(h, [960, 1600, 2400]);
const srcV = await srcset(v, [640, 1080]);
const base = h ? await getImage({ src: h, width: Math.min(1600, h.width), format: 'webp', quality: 68 }) : null;
---
<header class="barra" id="barra">
  <div class="barra__in contenedor">
    <a href="#inicio" class="marca" aria-label="Inicio">
      <Image src={logoHorizontal} alt={portada.nombre} widths={[300, 600]} sizes="(min-width: 1101px) 255px, 210px" loading="eager" class="marca__logo" />
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu">
      <span class="menu-btn__txt">Menú</span>
      <span class="menu-btn__ico" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
    <nav id="menu" aria-label="Secciones">
      <ul>
        {nav.map((n, i) => <li><a href={`#${n.id}`}><span class="menu__n">{String(i + 1).padStart(2, '0')}</span>{n.texto}</a></li>)}
      </ul>
      <div class="menu__redes"><Redes variante="menu" /></div>
    </nav>
  </div>
</header>

<script>
  // Menú desplegable del celular
  const barra = document.getElementById('barra')!;
  const boton = barra.querySelector<HTMLButtonElement>('.menu-btn')!;
  const texto = boton.querySelector('.menu-btn__txt')!;
  const fijar = (abierto: boolean) => {
    barra.classList.toggle('abierta', abierto);
    boton.setAttribute('aria-expanded', String(abierto));
    texto.textContent = abierto ? 'Cerrar' : 'Menú';
    document.documentElement.classList.toggle('sin-scroll', abierto);
  };
  boton.addEventListener('click', () => fijar(!barra.classList.contains('abierta')));
  barra.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => fijar(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fijar(false); });
  matchMedia('(min-width: 1101px)').addEventListener('change', () => fijar(false));
</script>

<section id="inicio" class="portada">
  {base ? (
    <picture>
      {srcV && <source media="(max-width: 700px)" srcset={srcV} sizes="100vw" type="image/webp" />}
      <source srcset={srcH} sizes="100vw" type="image/webp" />
      <img src={base.src} alt="Víctor Armando Martínez Perafán" class="portada__img" fetchpriority="high" loading="eager" decoding="async" />
    </picture>
  ) : (
    <div class="portada__img portada__img--pendiente" role="img" aria-label="Retrato principal de Víctor Armando">
      <span>Foto pendiente: portada.jpg (16:9) y portada-vertical.jpg (9:16)</span>
    </div>
  )}
  <div class="portada__velo"></div>

  <div class="portada__texto contenedor">
    <p class="rotulo">{portada.rotulo}</p>
    <h1>
      <Image src={logoApilado} alt={portada.nombre} widths={[400, 800, 1200]} sizes="(min-width: 760px) 560px, 82vw" loading="eager" fetchpriority="high" class="logo-portada" />
    </h1>
    <p class="frase">{portada.frase}</p>
    <p class="credenciales">{portada.credenciales.join(' · ')}</p>
    <Redes variante="portada" />
  </div>

  <ul class="datos">
    {portada.datos.map((d) => (
      <li><Icono nombre={d.icono} size={26} /><span>{d.texto}</span></li>
    ))}
  </ul>
</section>

<style>
  .barra { position: sticky; top: 0; z-index: 50; background: var(--rojo); color: #fff; }
  .barra__in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 80px; }
  .marca { display: block; flex: none; line-height: 0; }
  .marca :global(.marca__logo) { width: 255px; height: auto; }
  .barra ul { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
  .barra nav a { font: 400 1.3rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; white-space: nowrap; }
  .barra nav a:hover { text-decoration: underline; text-decoration-color: var(--ambar); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .menu__n { display: none; }
  .menu-btn { display: none; }
  .menu__redes { display: none; }

  @media (max-width: 1100px) {
    .barra__in { min-height: 72px; }
    .marca :global(.marca__logo) { width: 210px; }
    .menu-btn {
      display: inline-flex; align-items: center; gap: 0.6rem;
      background: var(--ambar); color: var(--negro); border: 0; cursor: pointer;
      font: 400 1.45rem/1 var(--display); letter-spacing: 0.08em; text-transform: uppercase;
      padding: 0.55rem 0.8rem 0.45rem;
    }
    .menu-btn__ico { position: relative; width: 22px; height: 16px; }
    .menu-btn__ico i { position: absolute; left: 0; width: 100%; height: 3px; background: currentColor; transition: transform 0.25s, opacity 0.2s; }
    .menu-btn__ico i:nth-child(1) { top: 0; }
    .menu-btn__ico i:nth-child(2) { top: 6.5px; }
    .menu-btn__ico i:nth-child(3) { top: 13px; }
    .abierta .menu-btn__ico i:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .abierta .menu-btn__ico i:nth-child(2) { opacity: 0; }
    .abierta .menu-btn__ico i:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    .barra nav {
      display: none; position: fixed; left: 0; right: 0; top: 72px; bottom: 0; overflow-y: auto;
      background: var(--rojo); padding: 1rem var(--gutter) 3rem;
      border-top: 3px solid var(--ambar);
    }
    .abierta nav { display: block; }
    .barra ul { flex-direction: column; gap: 0; }
    .barra li { border-bottom: 1px solid rgb(255 255 255 / 0.2); }
    .barra nav a { display: flex; align-items: baseline; gap: 1rem; padding: 1.1rem 0 0.9rem; font-size: clamp(2.4rem, 11vw, 3.4rem); white-space: normal; }
    .menu__n { display: inline; font-size: 1.2rem; color: rgb(255 255 255 / 0.8); letter-spacing: 0.1em; }
    .menu__redes { display: block; }
  }
  :global(html.sin-scroll) { overflow: hidden; }

  .portada { position: relative; min-height: calc(100svh - 80px); display: grid; grid-template-rows: 1fr auto; color: #fff; overflow: hidden; background: var(--rojo-hondo); }
  .portada__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 12%; }
  .portada__img--pendiente { display: grid; place-items: start end; padding: 2rem; background: linear-gradient(120deg, var(--rojo-hondo), var(--rojo)); }
  .portada__img--pendiente span { border: 1px dashed rgb(255 255 255 / 0.6); padding: 0.6rem 0.9rem; font-size: 0.9rem; max-width: 30ch; }
  .portada__velo { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(19 17 12 / 0.78) 0%, rgb(19 17 12 / 0.35) 55%, transparent 80%), linear-gradient(0deg, rgb(19 17 12 / 0.55), transparent 40%); }
  .portada__texto { position: relative; align-self: end; padding-block: 12vh 2rem; }
  .rotulo { display: inline-block; background: var(--ambar); color: var(--negro); font: 400 1.25rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.12em; padding: 0.45rem 0.75rem 0.35rem; }
  h1 { margin-top: 1.4rem; line-height: 0; }
  h1 :global(.logo-portada) { width: clamp(260px, 44vw, 560px); height: auto; filter: drop-shadow(0 2px 14px rgb(19 17 12 / 0.35)); }
  .frase { margin-top: 1.4rem; font: italic 500 clamp(1.4rem, 2.8vw, 2.1rem)/1.2 var(--serif); max-width: 24ch; }
  .credenciales { margin-top: 1rem; font-size: clamp(0.95rem, 1.4vw, 1.1rem); opacity: 0.92; max-width: 60ch; }

  .datos { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); background: var(--ambar); color: var(--negro); }
  .datos li { display: flex; align-items: center; gap: 0.75rem; padding: 1.1rem var(--gutter); font-weight: 500; line-height: 1.3; }
  .datos li + li { border-left: 2px solid rgb(19 17 12 / 0.15); }
  @media (max-width: 760px) {
    .portada { min-height: calc(100svh - 72px); }
    .portada__velo { background: linear-gradient(0deg, rgb(19 17 12 / 0.9) 0%, rgb(19 17 12 / 0.4) 55%, rgb(19 17 12 / 0.1) 100%); }
    .portada__texto { padding-top: 30vh; }
    .datos { grid-template-columns: 1fr; }
    .datos li { padding-block: 0.7rem; }
    .datos li + li { border-left: 0; border-top: 2px solid rgb(19 17 12 / 0.12); }
  }
</style>
