---
import '../styles/global.css';
import { sitio, portada } from '../data/contenido';
import { foto } from '../lib/medios';
import { getImage } from 'astro:assets';

const og = foto('compartir') ?? foto('portada');
const ogImg = og ? await getImage({ src: og, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : null;
const ogUrl = ogImg ? new URL(ogImg.src, sitio.url).href : null;

const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: portada.nombre,
  url: sitio.url,
  description: portada.frase,
  birthPlace: 'El Rosal, San Sebastián, Cauca, Colombia',
  homeLocation: 'Popayán, Cauca, Colombia',
  alumniOf: ['Universidad del Cauca', 'Colegio Francisco Antonio de Ulloa'],
  jobTitle: 'Ingeniero Agroindustrial',
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{sitio.titulo}</title>
    <meta name="description" content={sitio.descripcion} />
    <link rel="canonical" href={sitio.url + '/'} />
    <meta name="theme-color" content="#2619d1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={sitio.url + '/'} />
    <meta property="og:title" content={portada.nombre} />
    <meta property="og:description" content={portada.frase} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=League+Gothic&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(persona)} />
  </head>
  <body>
    <slot />
    <script>
      // Aparición al hacer scroll
      const io = new IntersectionObserver((entradas) => {
        for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.revela').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
